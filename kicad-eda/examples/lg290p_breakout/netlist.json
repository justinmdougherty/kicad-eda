{
  "name": "lg290p_breakout",
  "title": "Quectel LG290P RTK GNSS breakout (u.FL, 3.3 V LDO, UART/PPS header)",
  "require_sourcing": true,
  "assumptions": [
    {
      "id": "board.copper_layers",
      "topic": "copper layer count",
      "value": 4,
      "rationale": "the 55 inner GND pads of the LGA-79 escape through vias to an unbroken In1.Cu GND plane that is also the reference of the 50 ohm RF_IN / ANT feed; In2.Cu carries +3V3 (the builder's default planes). On 2 layers the escape vias and the routing would share one bottom pour (ROADMAP D7: layer count per design)",
      "confidence": "high",
      "override": "copper_layers"
    },
    {
      "id": "gnss.inner_gnd",
      "topic": "LG290P inner GND pads",
      "value": "F2-S1 strategy (f): 40 generated escape vias, the netlist_hints of author_footprint(preset='lg290p') placed at U1",
      "rationale": "F2-S1 measured DRC 0 / unconnected 0 on KiCad 9.0.4 and 10.0.5 with the fastest routing; every F.Cu GND zone poured before routing failed",
      "confidence": "high",
      "override": "preroutes"
    },
    {
      "id": "mech.lid",
      "topic": "enclosure height",
      "value": "2.8 mm over the whole top side, J2 exempt",
      "rationale": "the LG290P body is 2.6 mm (2.8 mm max): nothing else may stand taller",
      "confidence": "med",
      "override": "height_zones"
    },
    {
      "id": "mech.keep_clear",
      "topic": "module keep-clear",
      "value": "3 mm around the LG290P body",
      "rationale": "LG290P Hardware Design: keep other components >= 3 mm from the module; written as a max_height 0 height zone that exempts U1",
      "confidence": "high",
      "override": "height_zones"
    },
    {
      "id": "power.input",
      "topic": "supply",
      "value": "5 V on J2 pin 1 -> AP2112K-3.3 LDO -> +3V3",
      "rationale": "the host powers the breakout through its UART/PPS header; V_BCKP is fed from +3V3 through BAT54J with a 4.7 uF hold-up cap",
      "confidence": "med",
      "override": "net_specs.VIN"
    },
    {
      "id": "rf.antenna",
      "topic": "GNSS antenna",
      "value": "active antenna on u.FL J1",
      "rationale": "VDD_RF biases it through 10 ohm + 68 nH, a 100 pF cap blocks DC to RF_IN and an 0402 ESD diode guards the connector (LG290P active-antenna reference)",
      "confidence": "med",
      "override": "components"
    }
  ],
